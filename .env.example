# ===========================================
# Hospital Management System - Docker Config
# ===========================================
# Copy this file to .env and update values for your environment
# All variables have sensible defaults, but security-related ones MUST be changed

# ===========================================
# IMAGE VERSIONS (Pin versions for production)
# ===========================================
POSTGRES_VERSION=15-alpine
BACKEND_IMAGE_TAG=1.0.0.0
FRONTEND_IMAGE_TAG=latest
TV_LEGACY_IMAGE_TAG=latest

# ===========================================
# CONTAINER NAMES
# ===========================================
POSTGRES_CONTAINER_NAME=hms-postgres
BACKEND_CONTAINER_NAME=hms-platform-backend
FRONTEND_CONTAINER_NAME=hospital-ui
TV_LEGACY_CONTAINER_NAME=tv-legacy-display
REDIS_CONTAINER_NAME=hms-redis

# ===========================================
# PORT MAPPINGS
# ===========================================
POSTGRES_PORT=5444
APP_PORT=8155
FRONTEND_PORT=8154
TV_LEGACY_PORT=8156

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hms_db

# ===========================================
# HMS Backend Configuration
# ===========================================
# SECURITY: Generate random 32+ character strings for these keys
# Use: openssl rand -hex 32 or similar
# JWT Configuration (RS256)
# Generate keys with: python scripts/generate_jwt_keys.py
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
# Alternatively inline:
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
LOG_FORMAT=json
LICENSE_ENCRYPTION_KEY=CHANGE_THIS_GENERATE_RANDOM_STRING_MIN_32_CHARS
AADHAAR_ENCRYPTION_KEY=CHANGE_THIS_GENERATE_RANDOM_STRING_MIN_32_CHARS
MAX_FILE_SIZE_MB=5

# API Documentation / Swagger UI
# Controls /docs, /redoc, and /openapi.json.
# Default: false in production (returns 404).
# If set to true in production, DOCS_USERNAME and DOCS_PASSWORD are REQUIRED
# to enforce HTTP Basic Authentication. If credentials are not set, it fails closed (404).
DOCS_ENABLED=false
DOCS_USERNAME=
DOCS_PASSWORD=

# ===========================================
# ABDM / ABHA Integration Configuration
# ===========================================
ABDM_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
ABDM_X_CM_ID=sbx
ABDM_HIP_ID=IN0610090730
ABDM_PHR_BASE_URL=https://phrsbx.abdm.gov.in
ABDM_HIECM_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_BRIDGE_URL=
ABDM_BRIDGE_API_KEY=
ABDM_BRIDGE_CALLBACK_URL=
ABDM_CALLBACK_BASE_URL=
ABDM_CALLBACKS_ENABLED=false
ABDM_CALLBACK_ISSUER=https://dev.abdm.gov.in/auth/realms/central-registry
ABDM_JWKS_URI=
ABDM_CALLBACK_IP_ALLOW_LIST=
INTAKE_TOKEN_EXPIRY_MINUTES=120
SMS_PROVIDER=logging

# ===========================================
# OpenTelemetry & Grafana Cloud Observability
# ===========================================
# Grafana Cloud OTLP Gateway Endpoint
# Example: https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
# Basic Auth Header generated from Grafana Cloud (Basic <base64(instance_id:api_token)>)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <BASE64_INSTANCE_ID_AND_API_TOKEN>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=hms-backend
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=hms

# ===========================================
# Hospital UI Configuration
# ===========================================
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.13:8155
NEXT_PUBLIC_DOMAIN_URL=localhost:8154
NEXT_PUBLIC_BASE_PATH=

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_RETENTION_DAYS=30

# ===========================================
# Cura E2E Test Runner Configuration
# ===========================================
E2E_CONTAINER_NAME=hms-e2e-runner
E2E_IMAGE_TAG=latest
E2E_PORT=8158
E2E_PLAYWRIGHT_UI_PORT=8159
# Target URL: Use internal Docker service http://hospital-ui:80 or external domain
E2E_BASE_URL=http://hospital-ui:80
E2E_API_URL=http://hms-backend:8000
E2E_HOSPITAL_ID=demo-hospital
E2E_ADMIN_EMAIL=admin@demo.com
E2E_ADMIN_PASSWORD=admin123
# Subpath routing: set to /e2e if reverse proxied behind domain.com/e2e, leave blank for root subdomain
E2E_BASE_PATH=
# Emergency offline admin bypass password (if HMS backend/DB is down)
EMERGENCY_ADMIN_PASS=admin123
